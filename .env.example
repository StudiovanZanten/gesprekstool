# Database (Neon, regio Frankfurt). Zelf invullen, nooit delen.
DATABASE_URL=postgres://gebruiker:wachtwoord@host/gesprekstool?sslmode=require

# Sleutel voor versleuteling van antwoorden. Maak er een met: npm run sleutel
ENCRYPTION_KEY=

# Geheim voor inlogcodes en de dagelijkse taak. Maak er een met: npm run sleutel
APP_SECRET=
CRON_SECRET=

# Adres waarop de tool online staat, zonder / aan het eind
APP_URL=http://localhost:3000

# Mail via Brevo. Leeg laten op je laptop: dan verschijnen inloglinks in het venster waar de app draait.
BREVO_API_KEY=
MAIL_FROM=noreply@studiovanzanten.com
MAIL_FROM_NAME=Gesprekstool
